# ── MQTT broker (esp.ts, sender.ts) ─────────────────────────────────────────

# Broker the simulated device connects to. Defaults to a local EMQX on 1883.
# A hosted broker is usually TLS-only: mqtts://<id>.emqxsl.com:8883
MQTT_URL=mqtt://localhost:1883

# Device credentials. Blank against a local anonymous EMQX; on a hosted broker
# these are the per-device account, whose ACL should allow only this device's
# own `d/<connectorId>/#` topics.
MQTT_USERNAME=
MQTT_PASSWORD=

# The simulated device's private connector id and its raw API key (shown once
# in the dashboard). esp.ts replies with these.
CONNECTOR_ID=
API_KEY=

# The broker's CA, if its certificate isn't signed by a public CA. Inline PEM,
# or a path to the downloaded file.
MQTT_CA_CERT=
MQTT_CA_PATH=

# ── x402 buyer (agent.ts) ────────────────────────────────────────────────────

# Device-controller base URL the agent pays against.
# Production: https://device-controller.0xbs.org
DEVICE_CONTROLLER_URL=http://localhost:4001

# Service to call (must exist for DEVICE_ID in config.ts).
SERVICE_ID=9b410005-f14d-4940-880c-ca08d34fe1ae

# One key per supported wallet family. The agent pays on the FIRST network the
# server advertises, signing with whichever family's key matches that network.
# A missing key falls back to a throwaway (signs, but can't settle without funds).

# EVM wallet — 0x-prefixed 32-byte hex. Used for Base / Polygon / Arbitrum /
# World and their testnets. Fund it with testnet USDC (+ a little gas).
# Generate one: `node -e "console.log(require('viem/accounts').generatePrivateKey())"`
AGENT_EVM_PRIVATE_KEY=

# Solana wallet — base58 secret key (32-byte private or 64-byte keypair). Used
# for Solana mainnet / devnet. Fund it with USDC (+ a little SOL for rent).
AGENT_SOLANA_PRIVATE_KEY=
AGENT_EVM_PRIVATE_KEY=