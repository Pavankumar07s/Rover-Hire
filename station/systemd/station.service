[Unit]
Description=Station-A: signed sensor readings for Rover for Hire (Phase 12)
After=network-online.target arduino-router.service
Wants=network-online.target

[Service]
User=arduino
SupplementaryGroups=arduino-router
WorkingDirectory=/home/arduino/0xbs-station
EnvironmentFile=/home/arduino/0xbs-station/station.env
ExecStart=/home/arduino/0xbs-station/venv/bin/python -m station.main
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
