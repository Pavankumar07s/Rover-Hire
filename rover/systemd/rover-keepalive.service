[Unit]
Description=0xBs rover Wi-Fi keep-alive (the ath10k radio naps when the link is idle)
After=network-online.target
Wants=network-online.target

[Service]
User=arduino
ExecStart=/home/arduino/0xbs-rover/rover/systemd/keepalive.sh
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
