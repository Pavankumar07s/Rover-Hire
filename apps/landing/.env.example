# Console (apps/web) — login / signup / dashboard.
# Local: http://localhost:3000
# Production: https://app.0xbs.org
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Docs (apps/docs).
# Local: http://localhost:3001
# Production: https://docs.0xbs.org
NEXT_PUBLIC_DOCS_URL="http://localhost:3001"

# Public device-controller API used in code samples.
# Production: https://device-controller.0xbs.org
NEXT_PUBLIC_DEVICE_CONTROLLER_URL="https://device-controller.0xbs.org"

# Optional. Used by `node scripts/generate-images.mjs` to refresh /public/generated.
# Falls back to the repo-root OPEN_ROUTER_API_KEY if unset.
# OPEN_ROUTER_API_KEY=
# OPEN_ROUTER_IMAGE_MODEL="black-forest-labs/flux.2-pro"
