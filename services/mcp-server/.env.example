# Public device API. Defaults to production if unset.
# Local: http://localhost:4001
DEVICE_CONTROLLER_URL=https://device-controller.0xbs.org

# Optional. If unset, Claude can call create_wallet and keys are stored in
# ~/.0xbs/wallet.json (never returned to the model). Env keys override that file.
# AGENT_EVM_PRIVATE_KEY=0x…
# AGENT_SOLANA_PRIVATE_KEY=

# Hard ceiling on a single automatic payment, in USDC. Keep it near what a call
# should actually cost. Device services here quote $0.01.
MAX_PAYMENT_USDC=0.10
