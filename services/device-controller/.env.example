# Port this service listens on.
PORT=4001

# MUST match auth-controller — used to verify login JWTs from the same secret.
JWT_SECRET=

# Dashboard origin (CORS allow-list for cookie/JWT /devices calls).
# Local: http://localhost:3000
# Production: https://app.0xbs.org  — not the landing host (0xbs.org).
FRONTEND_URL=http://localhost:3000

# Postgres connection string (this service runs from its own dir under `pnpm dev`,
# so it loads THIS .env, not the root one). MUST point at the same DB as packages/db.
DATABASE_URL=

# Redis connection. When set, device presence (online/active) is shared across
# all replicas. Leave unset for local dev to use an in-memory fallback.
# Example: redis://localhost:6379
REDIS_URL=

# MQTT broker (EMQX) URL — the live channel to talk to ESP32 devices. The
# service holds ONE connection open for its lifetime and multiplexes every
# device call over it, so a hosted broker isn't billed per request.
# Local EMQX started via Docker listens on 1883:  mqtt://localhost:1883
# EMQX Cloud Serverless is TLS-only:              mqtts://<id>.emqxsl.com:8883
MQTT_URL=mqtt://localhost:1883

# Broker credentials. Leave blank for a local EMQX (anonymous access is on by
# default); REQUIRED on any hosted broker, which will refuse anonymous clients.
# Use a server-only account whose ACL covers `d/#` — devices get their own
# accounts restricted to their single `d/<connectorId>/#` subtree.
MQTT_USERNAME=
MQTT_PASSWORD=

# Only needed when the broker's TLS certificate isn't signed by a public CA
# (self-hosted with a private CA, or a broker that ships its own). Supply the
# PEM inline via MQTT_CA_CERT or point MQTT_CA_PATH at the downloaded file.
MQTT_CA_CERT=
MQTT_CA_PATH=

# Set to "false" to skip TLS certificate verification. Debugging only — it makes
# the connection trivially interceptable.
MQTT_REJECT_UNAUTHORIZED=

# EMQX HTTP REST API — used by GET /devices/online to list connected clients.
# The dashboard/API listens on 18083 by default. Create an API key + secret in
# the EMQX dashboard under "System → API Keys".
# https://docs.emqx.com/en/emqx/latest/admin/api.html
EMQX_API_URL=http://localhost:18083/api/v5
EMQX_API_KEY=
EMQX_API_SECRET=

# ── x402 / Coinbase CDP facilitator ─────────────────────────────────────────
# CDP API key + secret from the Coinbase Developer Platform. REQUIRED to
# verify/settle payments and to fetch the Solana fee payer via getSupported().
# https://docs.cdp.coinbase.com/x402/seller/facilitator
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Public base URL of this service — used to build the x402 resource URL
# advertised in the 402 response. REQUIRED in production (no Host-header fallback).
# Local: http://localhost:4001
# Production: https://device-controller.0xbs.org
PUBLIC_URL=http://localhost:4001

# Which USDC networks to advertise on a 402: mainnet | testnet | all
# Production defaults to mainnet; local defaults to all.
X402_NETWORKS=all
